# Admin-Panel (Benutzerverwaltung) - LOKAL. Kopieren nach admin.env; mit REPLACE_ME markierte Werte ersetzen.
# Alle Werte ohne umschliessende Anfuehrungszeichen (docker run --env-file nimmt Quotes woertlich).
# Produktion: admin.env.example.

NODE_ENV=production
# Oeffentliche URL des Panels (Origin-Pruefung gegen CSRF, Cookie-Domain)
APP_ORIGIN=http://localhost:3021
# Lokal ohne TLS muss das Cookie auch ueber http gesendet werden
COOKIE_SECURE=false
# Lokal ohne Proxy false
TRUST_PROXY=false
# Zufallswert: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME

# Verzeichnisse im Container (Mounts siehe docker-compose.yml: ./admin-data -> /data, ./hostdata -> /hostdata)
DATA_DIR=/data
HOSTDATA_DIR=/hostdata

# Erster Administrator: wird nur angelegt, solange noch kein Benutzer existiert. Danach ueber das Panel pflegen;
# die BOOTSTRAP_*-Werte danach entfernen. Passwort-Regel: 8-128 Zeichen, Klein- und Grossbuchstabe, Ziffer, Sonderzeichen.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME

# Nutzungsstatistik (nur Administratoren, nur Anzahlen und Raumnamen, nie Teilnehmernamen).
# Interne Adresse von CouchChat im Docker-Netz (Dienstname, nicht die oeffentliche URL; Caddy sperrt /api/* oeffentlich)
COUCHCHAT_INTERNAL_URL=http://couchchat:3000
# Gleicher Wert wie API_KEY_SECRET in couchchat.env (Header "authorization"). Geheimnis, nie ins Repo.
COUCHCHAT_API_KEY=REPLACE_ME
# COUCHCHAT_IMAGE (Anzeige in der Systemkarte) setzt docker-compose.yml aus der .env; hier nicht eintragen.
# Optional: TURN-Server fuer die Erreichbarkeitspruefung (TCP, 2 s). Ohne TURN_HOST wird die Zeile ausgeblendet.
TURN_HOST=
TURN_PORT=3478
