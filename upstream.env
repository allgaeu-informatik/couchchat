# Single source of truth for the upstream MiroTalk P2P release that CouchChat is built on.
# Read by the Dockerfile (build args), scripts/build-image.sh and the GitHub workflows.
# Plain KEY=value lines, no quotes, no spaces (sourced by sh and parsed by CI).
#
# Update: see README ("Update-Prozedur"). The weekly workflow upstream-check.yml opens a PR that changes
# exactly these three lines.
MIROTALK_IMAGE=mirotalk/p2p@sha256:c470853ed1bf5fa22389718cb4f15532d985fbc6412fb21527093016495aafed
MIROTALK_VERSION=2.3.55
MIROTALK_COMMIT=71c11c67fbc8971fe39faeb0037f87e445464338
