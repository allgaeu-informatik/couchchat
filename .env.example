# Compose-Ebene (nur docker compose liest diese Datei, die App nicht).
# App-Variablen stehen in couchchat.env.
COMPOSE_PROJECT_NAME=couchchat

# Trenner fuer COMPOSE_FILE (einheitlich auf Windows und Linux)
COMPOSE_PATH_SEPARATOR=:

# ---- LOKAL (Standard): Image aus dem Dockerfile bauen, erreichbar unter http://localhost:<LOCAL_PORT>
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COUCHCHAT_IMAGE=couchchat:local
LOCAL_PORT=3020

# ---- PRODUKTION: fertiges Image aus der GitHub Container Registry, hinter Caddy.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Image fest pinnen (Tag <Upstream-Version>-<git-sha> oder Digest), nie :latest:
# COUCHCHAT_IMAGE=ghcr.io/allgaeu-informatik/couchchat:2.3.22-abc1234
# Name des externen Docker-Netzwerks, in dem Caddy haengt (einmalig: docker network create caddy)
# CADDY_NETWORK=caddy
