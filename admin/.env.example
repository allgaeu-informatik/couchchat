# CouchChat Admin - Beispielkonfiguration (keine echten Geheimnisse eintragen)

# Öffentliche URL des Panels. Wird für den Origin-/CSRF-Check verwendet und muss exakt der Browser-URL entsprechen.
APP_ORIGIN=http://localhost:3021

# SQLite-Datenbank (admin.sqlite) liegt hier. Im Container: /data (Volume).
DATA_DIR=./data

# Verzeichnis für host-users.json. CouchChat (MiroTalk) mountet dasselbe Verzeichnis read-only. Im Container: /hostdata.
HOSTDATA_DIR=./hostdata

# false nur für lokale Entwicklung über http (dann Cookie "cc_admin" statt "__Host-cc_admin").
COOKIE_SECURE=false

# true nur hinter dem lokalen Reverse Proxy (Caddy): X-Forwarded-For wird dann für Rate-Limit und Audit-Log ausgewertet.
TRUST_PROXY=false

# Erst-Admin, nur wirksam wenn die Benutzertabelle leer ist. Nach dem ersten Start wieder entfernen!
# Passwort-Policy: 8-128 Zeichen, Klein-/Großbuchstabe, Ziffer, Sonderzeichen.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Nutzungsstatistik (nur Administratoren, nur Anzahlen und Raumnamen). Leer = Statistik aus.
# Interne URL von CouchChat (im Compose-Netz http://couchchat:3000, bei lokaler Entwicklung z. B. http://localhost:3020)
COUCHCHAT_INTERNAL_URL=
# API_KEY_SECRET von CouchChat (Header "authorization")
COUCHCHAT_API_KEY=
# Anzeige in der Systemkarte (sonst "unbekannt")
COUCHCHAT_IMAGE=
# Optional: TURN-Erreichbarkeit (TCP). Ohne TURN_HOST wird die Zeile ausgeblendet.
TURN_HOST=
TURN_PORT=3478
