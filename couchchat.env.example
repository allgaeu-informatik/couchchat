# CouchChat App-Konfiguration (env_file, wird von docker compose gelesen).
# Format: KEY=value, ohne Anfuehrungszeichen und ohne Inline-Kommentare
# (Ausnahme: CORS_ORIGIN braucht JSON, siehe dort). Kein Dollarzeichen in Werten verwenden.
# Booleans immer explizit true/false setzen (Upstream-Defaults sind teils true).
# Brand-Texte nie leer lassen: leere Werte fallen auf die eingebauten Defaults zurueck.
# PRODUKTION. Kopieren nach couchchat.env; mit REPLACE_ME markierte Werte ersetzen
# (Zufallswerte: openssl rand -hex 32). Der Container startet NICHT, solange REPLACE_ME in JWT_KEY,
# API_KEY_SECRET, TURN_SERVER_USERNAME, TURN_SERVER_CREDENTIAL oder HOST_USERS steht (Start-Guard).
# Lokale Entwicklung: couchchat.env.local.example.

# ---- Betrieb und Sicherheit ----
NODE_ENV=production
PORT=3000
# Lokal: http://localhost:3020 und TRUST_PROXY=false
HOST=https://couchchat.de
# Produktion hinter Caddy: true. Lokal: false.
TRUST_PROXY=true
JWT_KEY=REPLACE_ME
API_KEY_SECRET=REPLACE_ME
JWT_EXP=1h
# Host-Login (Zwischenloesung bis zum eigenen OIDC-Dienst): nur angemeldete Hosts koennen Raeume anlegen,
# Gaeste betreten bestehende Raeume per Link ohne Login. HOST_USER_AUTH=true wuerde dagegen JEDEN Teilnehmer
# zur Anmeldung zwingen und darf deshalb nicht gesetzt werden. Passwort 1-36 Zeichen, JSON-Array ohne umschliessende
# Anfuehrungszeichen (docker run --env-file nimmt Quotes woertlich). Weitere Hosts als weitere Eintraege; allowed_rooms ["*"] = alle Raeume.
HOST_PROTECTED=true
HOST_USER_AUTH=false
HOST_USERS=[{"username":"REPLACE_ME","password":"REPLACE_ME","displayname":"Host","allowed_rooms":["*"]}]
# JSON-Array ohne umschliessende Anfuehrungszeichen (docker run --env-file entfernt keine Quotes, compose schon)
CORS_ORIGIN=["https://couchchat.de"]
ALLOWED_EMBED_ORIGINS=self
SHOW_ACTIVE_ROOMS=false
OIDC_ENABLED=false
IP_WHITELIST_ENABLED=false
API_DISABLED=["token","meetings"]

# ---- Marke und Sprache ----
BRAND_HTML_INJECTION=true
APP_NAME=CouchChat
APP_TITLE=<h1>CouchChat</h1>Videochats im Browser.<br />Einfach, sicher, schnell.
APP_DESCRIPTION=CouchChat ist der Videochat der Allgäu Informatik GmbH. Meetings direkt im Browser starten, ohne Installation.
JOIN_DESCRIPTION=Raumname eingeben oder einen neuen Raum starten und den Link teilen.
JOIN_BUTTON_LABEL=RAUM BEITRETEN
CUSTOMIZE_BUTTON_LABEL=RAUM ANPASSEN
JOIN_LAST_LABEL=Letzten Raum erneut betreten
UI_LANGUAGE=de
UI_TRANSLATION_MODE=native

# ---- Seitentitel (alle deutsch) ----
SITE_TITLE=CouchChat - Videochat im Browser
NEW_CALL_TITLE=CouchChat - Neuer Raum
NEW_ROOM_TITLE=Neuen Raum erstellen
NEW_ROOM_DESC=Wählen Sie einen Raumnamen oder lassen Sie einen zufälligen Namen erzeugen und teilen Sie den Link mit Ihren Gesprächspartnern.
LOGIN_TITLE=CouchChat - Anmeldung
LOGIN_HEADING=Anmeldung
LOGIN_DESCRIPTION=Bitte melden Sie sich an, um einen Raum zu starten.
LOGIN_BUTTON_LABEL=Anmelden
JOIN_ROOM_TITLE=CouchChat - Raum beitreten
JOIN_ROOM_BUTTON_LABEL=Beitreten
CLIENT_TITLE=CouchChat - Videochat
PRIVACY_POLICY_TITLE=CouchChat - Datenschutz
STUN_TURN_TITLE=CouchChat - Verbindungstest
NOT_FOUND_TITLE=CouchChat - Seite nicht gefunden
WHO_ARE_YOU_TITLE=CouchChat - Warteraum
WHO_ARE_YOU_WAITING_ROOM_HEADING=Warteraum
WHO_ARE_YOU_WAITING_ROOM_DESCRIPTION=Bitte warten Sie, bis der Gastgeber Sie in den Raum lässt.
WHO_ARE_YOU_WAITING_ROOM_STATUS=Status
WHO_ARE_YOU_WAITING_ROOM_WAITING=Sie warten auf Einlass
WHO_ARE_YOU_WAITING_ROOM_READY=Der Raum ist bereit
WHO_ARE_YOU_WAITING_ROOM_ELAPSED_JUST=Gerade eben
WHO_ARE_YOU_WAITING_ROOM_ELAPSED_MINUTES=Wartezeit: {minutes}
WHO_ARE_YOU_WAITING_ROOM_HOST_LINK=Sie sind der Gastgeber?
WHO_ARE_YOU_WAITING_ROOM_LOGIN_LINK=Als Gastgeber anmelden

# ---- SEO und Open Graph ----
OG_TYPE=website
OG_SITE_NAME=CouchChat
OG_TITLE=CouchChat - Videochat im Browser
OG_DESCRIPTION=Sichere Videomeetings direkt im Browser, ohne Installation. Ein Service der Allgäu Informatik GmbH.
OG_IMAGE_URL=https://couchchat.de/images/preview.png
OG_URL=https://couchchat.de

# ---- Icons (Dateien erzeugt scripts/build-overrides.sh) ----
SITE_ICON_PATH=../images/couchchat.svg
APPLE_TOUCH_ICON_PATH=../images/couchchat-touch.png
ABOUT_IMAGE_URL=../images/couchchat-logo.gif

# ---- Sichtbarkeit Landing / Footer ----
SHOW_TOP_SPONSORS=false
SHOW_LANDING_ABOUT=false
SHOW_FAQ=false
SHOW_TEAMS=false
SHOW_TRY_EASIER=false
SHOW_POWERED_BY=false
SHOW_SPONSORS=false
SHOW_PAST_SPONSORS=false
SHOW_ADVERTISERS=false
SHOW_SUPPORT_US=false
SHOW_VERSION=false
SHOW_APP_SWITCHER=false
SHOW_FEATURES=true
SHOW_FOOTER=true
APP_SWITCHER_DOCS_URL=
WIDGET_ENABLED=false

# ---- About-Dialog und Einladungen ----
SHOW_ABOUT=false
SHOW_EMAIL_INVITE=false
SHOW_ROOMS=false
SHOW_GEO_LOCATION=false
# Neutrale Werte, falls der About-Dialog doch aktiviert wird (sonst greifen MiroTalk-Defaults)
SUPPORT_URL=https://allgaeu-informatik.de/kontakt
SUPPORT_TEXT=Kontakt
AUTHOR_LABEL=Anbieter
AUTHOR_NAME=Allgäu Informatik GmbH
LINKEDIN_URL=https://allgaeu-informatik.de
CONTACT_EMAIL=kontakt@allgaeu-informatik.de
EMAIL_LABEL=E-Mail
EMAIL_SUBJECT=CouchChat Anfrage
COPYRIGHT_TEXT=Allgäu Informatik GmbH. Alle Rechte vorbehalten.

# ---- Datenschutz und externe Dienste (alle aus) ----
STATS_ENABLED=false
SURVEY_ENABLED=false
REDIRECT_ENABLED=true
REDIRECT_URL=https://couchchat.de/newcall
IP_LOOKUP_ENABLED=false
SENTRY_ENABLED=false
CHATGPT_ENABLED=false
CHAT_TRANSLATION_ENABLED=false
WHISPER_ENABLED=false
KLIPY_API_ENABLED=false
SLACK_ENABLED=false
MATTERMOST_ENABLED=false
NGROK_ENABLED=false
WEBHOOK_ENABLED=false
EMAIL_ALERT=false

# ---- STUN / TURN ----
# Produktion: eigener coturn (docker-compose.prod.yml, Profil turn, oder separater Host), kein Drittanbieter-STUN (z. B. Google).
# Es gibt je nur eine URL; die Zugangsdaten sind im Browser sichtbar.
STUN_SERVER_ENABLED=true
STUN_SERVER_URL=stun:turn.couchchat.de:3478
TURN_SERVER_ENABLED=true
TURN_SERVER_URL=turn:turn.couchchat.de:3478
TURN_SERVER_USERNAME=REPLACE_ME
TURN_SERVER_CREDENTIAL=REPLACE_ME
APP_SWITCHER_DOMAIN=couchchat.de
WIDGET_SUPPORT_POWERED_BY=CouchChat
WIDGET_SUPPORT_HEADING=Hilfe
WIDGET_SUPPORT_SUBHEADING=Wir helfen gern weiter
WIDGET_SUPPORT_EXPERT_IMAGES=../images/couchchat-logo.png
