# coturn fuer CouchChat. Kopieren nach coturn/turnserver.conf und Platzhalter ersetzen.
# DNS: turn.couchchat.de -> A-Record auf die Server-IP, OHNE CDN-Proxy.
# Firewall: 3478 UDP+TCP, 5349 TCP, Relay-Range min-port..max-port UDP.
# Die Zugangsdaten muessen identisch zu TURN_SERVER_USERNAME/TURN_SERVER_CREDENTIAL
# in couchchat.env sein (sie sind im Browser sichtbar, daher eigene Werte nur fuer TURN).

listening-port=3478
tls-listening-port=5349
listening-ip=SERVER.IP.ADRESSE
external-ip=SERVER.IP.ADRESSE
relay-ip=SERVER.IP.ADRESSE
# Hat turn.<domain> auch einen AAAA-Record, MUSS coturn zusaetzlich auf IPv6 lauschen und relayen, sonst laufen
# Browser mit IPv6 (die den AAAA-Record nehmen) bei STUN und TURN in Timeouts:
#listening-ip=SERVER:IPV6::ADRESSE
#relay-ip=SERVER:IPV6::ADRESSE
min-port=49152
max-port=49300

fingerprint
lt-cred-mech
user=TURN_USERNAME:TURN_PASSWORT
realm=turn.couchchat.de
server-name=turn.couchchat.de

# TLS (TURNS). Pfade zu den im Container gemounteten Zertifikaten.
cert=/certs/turn.couchchat.de.crt
pkey=/certs/turn.couchchat.de.key
no-tlsv1
no-tlsv1_1

# Haertung: kein Relay in interne Netze (SSRF), keine CLI, keine Multicast-Peers
no-cli
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255

# Quotas
total-quota=100
user-quota=12
bps-capacity=0
stale-nonce=600

# Minimale Logs
simple-log
no-stdout-log
log-file=/dev/null
